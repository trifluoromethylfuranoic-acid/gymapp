<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                              http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.epam.lenda.gymapp</groupId>
	<artifactId>parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>gymapp-parent</name>
	<description>Parent aggregator for all microservices</description>

	<modules>
		<module>main-service</module>
		<module>eureka-server</module>
		<module>report-service</module>
		<module>common</module>
	</modules>

	<properties>
		<java.version>17</java.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<spring-cloud.version>2025.1.2</spring-cloud.version>
		<docker.image.registry>lenda-gymapp</docker.image.registry>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>com.epam.lenda.gymapp</groupId>
				<artifactId>common</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<image>
							<name>${docker.image.registry}/${project.artifactId}:${project.version}</name>
							<tags>
								<tag>${docker.image.registry}/${project.artifactId}:latest</tag>
							</tags>
						</image>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>repackage</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>2.43.0</version>
				<configuration>
					<lineEndings>WINDOWS</lineEndings>
					<java>
						<removeUnusedImports/>
						<importOrder/>
						<formatAnnotations/>
						<endWithNewline/>
					</java>

					<yaml>
						<includes>
							<include>**/*.yml</include>
							<include>**/*.yaml</include>
						</includes>
						<excludes>
							<exclude>.idea/**</exclude>
							<exclude>target/**</exclude>
						</excludes>
						<endWithNewline/>
					</yaml>

					<formats>
						<format>
							<includes>
								<include>**/*.xml</include>
							</includes>
							<excludes>
								<exclude>.idea/**</exclude>
								<exclude>target/**</exclude>
							</excludes>
							<endWithNewline/>
						</format>

						<format>
							<includes>
								<include>.gitignore</include>
								<include>.gitattributes</include>
							</includes>
							<excludes>
								<exclude>.idea/**</exclude>
								<exclude>target/**</exclude>
							</excludes>
							<endWithNewline/>
						</format>

						<format>
							<includes>
								<include>**/*.json</include>
							</includes>
							<excludes>
								<exclude>.idea/**</exclude>
								<exclude>target/**</exclude>
							</excludes>
							<endWithNewline/>
						</format>
					</formats>
				</configuration>
				<executions>
					<execution>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
